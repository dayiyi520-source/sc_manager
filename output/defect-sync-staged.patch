+import { describe, it, expect } from 'vitest';
+import { syncProductTemplates, migrateWorkItems, isPendingVerification } from './workItemTemplateSync';
+const definition = { states: [{ key: 'todo', name: '待处理', enabled: true }, { key: 'fixed', name: '已修复', enabled: true }, { key: 'done', name: '已关闭', enabled: true }], transitions: [{ key: 'fix', from: 'todo', to: 'fixed' }] };
+const templates = [{ id: 'system-bug', name: '系统缺陷', category: '缺陷', enabled: true, workflow: { id: 'global-flow', status: 'PUBLISHED', definition } }];
+const members = [{ id: 'qa', name: '真实测试成员', status: 'enabled', jobTitle: '测试工程师' }, { id: 'disabled', name: '已离职', status: 'disabled' }];
+describe('product templates and historical defect migration', () => {
+  it('updates every product workflow and preserves matching type identity', () => {
+    const products = syncProductTemplates([{ id: 'p', workItemTypes: [{ id: 'existing', name: '系统缺陷', category: '缺陷', workflows: [{ id: 'existing-flow', status: 'PUBLISHED', definition: { states: [] } }] }] }, { id: 'p2' }], templates);
+    expect(products[0].workItemTypes[0]).toMatchObject({ id: 'existing', workflows: [{ id: 'existing-flow', definition }] });
+    expect(products[1].workItemTypes[0].workflows[0].definition).toEqual(definition);
+    expect(syncProductTemplates(products, templates)).toEqual(products);
+  });
+  it('repairs deleted bindings, preserves valid state, and persists real enabled verifier', () => {
+    const products = syncProductTemplates([{ id: 'p' }], templates);
+    const migrated = migrateWorkItems([{ id: 'b', category: 'bug', productLineId: 'p', workflowId: 'removed', taskTypeId: 'removed', status: '已修复', statusKey: 'old', verifierId: 'disabled', revision: 2 }], products, members);
+    expect(migrated[0]).toMatchObject({ status: '已修复', statusKey: 'fixed', verifierId: 'qa', verifierName: '真实测试成员', revision: 3 });
+    expect(migrated[0].workflowId).toBe(products[0].workItemTypes[0].workflows[0].id);
+    expect(migrateWorkItems(migrated, products, members)).toEqual(migrated);
+  });
+  it('redistributes invalid historical states once and honors future state changes', () => {
+    const products = syncProductTemplates([{ id: 'p' }], templates);
+    const migrated = migrateWorkItems(Array.from({ length: 9 }, (_, index) => ({ id: `bug-${index}`, category: 'bug', productLineId: 'p', status: '失效状态' })), products, members);
+    expect(new Set(migrated.map(task => task.statusKey)).size).toBe(3);
+    migrated[0] = { ...migrated[0], status: '已关闭', statusKey: 'done' };
+    expect(migrateWorkItems(migrated, products, members)).toEqual(migrated);
+  });
+  it('respects disabled templates and refreshes definitions on subsequent edits', () => {
+    const first = syncProductTemplates([{ id: 'p' }], templates);
+    const updated = syncProductTemplates(first, [{ ...templates[0], enabled: false, workflow: { ...templates[0].workflow, definition: { ...definition, states: definition.states.slice(1) } } }]);
+    expect(updated[0].workItemTypes[0].enabled).toBe(false);
+    expect(updated[0].workItemTypes[0].workflows[0].definition.states).toHaveLength(2);
+  });
+  it('does not fabricate employees when none are enabled', () => {
+    const task = { id: 'bug', category: 'bug', status: '已修复' };
+    expect(migrateWorkItems([task], [], [])).toEqual([task]);
+  });
+  it('filters assigned defects waiting for verification by identity and excludes closed bugs', () => {
+    const user = { id: 'qa', name: '真实测试成员' };
+    expect(isPendingVerification({ verifierId: 'qa', status: '已修复' }, user)).toBe(true);
+    expect(isPendingVerification({ verifierId: 'other', verifierName: user.name, status: '已修复' }, user)).toBe(false);
+    expect(isPendingVerification({ verifierName: user.name, status: '待验证' }, user)).toBe(true);
+    expect(isPendingVerification({ verifierId: 'qa', status: '已关闭' }, user)).toBe(false);
+    expect(isPendingVerification({ verifierId: 'qa', status: '处理中' }, user)).toBe(false);
+  });
+});
diff --git a/src/services/workItemTemplateSync.ts b/src/services/workItemTemplateSync.ts
new file mode 100644
index 0000000..a8001d3
--- /dev/null
+++ b/src/services/workItemTemplateSync.ts
@@ -0,0 +1,49 @@
+/** Idempotent migration of product template copies and historical task bindings. */
+const categoryCode = (category: string) => ({ 产品: 'requirement', 需求: 'requirement', 设计: 'design', 研发: 'dev', 测试: 'test', 缺陷: 'bug' } as Record<string, string>)[category] || category;
+export function syncProductTemplates(products: any[], templates: any[]) {
+  const available = templates.filter(type => type.workflow?.definition?.states?.some((state: any) => state.enabled !== false));
+  const signature = JSON.stringify(available);
+  return products.map(product => {
+    if (product.workItemTemplateSignature === signature) return product;
+    const previous = product.workItemTypes || [];
+    const inherited = available.map(template => {
+      const existing = previous.find((type: any) => type.sourceTemplateId === template.id || type.id === template.id || (type.name === template.name && categoryCode(type.category) === categoryCode(template.category)));
+      const typeId = existing?.id || `template-${product.id}-${template.id}`;
+      const workflowId = existing?.workflows?.find((flow: any) => flow.status === 'PUBLISHED')?.id || existing?.workflow?.id || `workflow-${typeId}`;
+      return { ...template, id: typeId, sourceTemplateId: template.id, workflow: undefined, revision: Number(existing?.revision || 0) + 1,
+        workflows: [{ ...template.workflow, id: workflowId, taskTypeId: typeId, category: categoryCode(template.category), status: 'PUBLISHED' }] };
+    });
+    const categories = new Set(available.map(type => categoryCode(type.category)));
+    const custom = previous.filter((type: any) => !type.sourceTemplateId && (!type.name || !categories.has(categoryCode(type.category))));
+    return { ...product, workItemTypes: [...inherited, ...custom], workItemTemplateSignature: signature };
+  });
+}
+export function migrateWorkItems(tasks: any[], products: any[], members: any[]) {
+  const enabledMembers = members.filter(member => member.status === 'enabled');
+  return tasks.map(task => {
+    let next = task;
+    const seed = [...String(task.id)].reduce((sum, char) => sum + char.charCodeAt(0), 0);
+    const types = products.find(product => product.id === task.productLineId)?.workItemTypes || [];
+    const candidates = types.filter((type: any) => type.enabled !== false && (categoryCode(type.category) === task.category || (!type.category && type.id === (task.taskTypeId || task.workItemTypeId))));
+    const type = candidates.find((type: any) => type.id === (task.taskTypeId || task.workItemTypeId)) || candidates.find((type: any) => type.name === (task.type || task.requirementType || task.taskType)) || candidates.find((type: any) => type.isDefault) || candidates[0];
+    const workflow = type?.sourceTemplateId ? type.workflows?.find((flow: any) => flow.status === 'PUBLISHED') : undefined;
+    const states = workflow?.definition?.states?.filter((state: any) => state.enabled !== false) || [];
+    if (states.length) {
+      const statusName = typeof task.status === 'string' ? task.status : task.status?.name;
+      const state = states.find((state: any) => state.name === statusName) || states.find((state: any) => state.key === task.statusKey) || states[seed % states.length];
+      if (task.taskTypeId !== type.id || task.workItemTypeId !== type.id || task.workflowId !== workflow.id || task.statusKey !== state.key || statusName !== state.name) {
+        next = { ...next, taskTypeId: type.id, workItemTypeId: type.id, workflowId: workflow.id, statusKey: state.key, status: state.name, revision: Number(task.revision || 0) + 1 };
+      }
+    }
+    if (task.category === 'bug' && enabledMembers.length) {
+      const testers = enabledMembers.filter(member => /测试|质量/.test(member.jobTitle || ''));
+      const pool = testers.length ? testers : enabledMembers;
+      const verifier = enabledMembers.find(member => task.verifierId ? member.id === task.verifierId : member.name === task.verifierName) || pool[seed % pool.length];
+      if (task.verifierId !== verifier.id || task.verifierName !== verifier.name) next = { ...next, verifierId: verifier.id, verifierName: verifier.name };
+    }
+    return next;
+  });
+}
+export function isPendingVerification(task: { verifierId?: string; verifierName?: string; status: string }, user: { id: string; name: string }) {
+  return (task.verifierId ? task.verifierId === user.id : task.verifierName?.trim() === user.name.trim()) && ['已修复', '待验证', '待验收', '待确认', '验证中'].includes(task.status);
+}
